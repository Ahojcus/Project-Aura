{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aura",
  "version": "0.6.0",
  "identifier": "com.freebuff.aura.functional",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    },
    "windows": [
      {
        "label": "settings",
        "title": "Aura Settings",
        "url": "index.html",
        "width": 900,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "visible": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=CalculateNativeWinOcclusion --disable-renderer-backgrounding --disable-background-timer-throttling --disable-backgrounding-occluded-windows"
      },
      {
        "label": "wallpaper",
        "url": "wallpaper.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "alwaysOnTop": false,
        "width": 1920,
        "height": 1080,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=CalculateNativeWinOcclusion --disable-renderer-backgrounding --disable-background-timer-throttling --disable-backgrounding-occluded-windows"
      },
      {
        "label": "notch",
        "url": "notch.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "alwaysOnTop": true,
        "width": 240,
        "height": 44,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=CalculateNativeWinOcclusion --disable-renderer-backgrounding --disable-background-timer-throttling --disable-backgrounding-occluded-windows"
      },
      {
        "label": "clock",
        "url": "clock.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "alwaysOnTop": true,
        "width": 360,
        "height": 220,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=CalculateNativeWinOcclusion --disable-renderer-backgrounding --disable-background-timer-throttling --disable-backgrounding-occluded-windows"
      },
      {
        "label": "todo",
        "url": "todo.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "alwaysOnTop": true,
        "width": 420,
        "height": 560,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=CalculateNativeWinOcclusion --disable-renderer-backgrounding --disable-background-timer-throttling --disable-backgrounding-occluded-windows"
      },
      {
        "label": "statusbar",
        "url": "statusbar.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "alwaysOnTop": true,
        "width": 1280,
        "height": 40,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=CalculateNativeWinOcclusion --disable-renderer-backgrounding --disable-background-timer-throttling --disable-backgrounding-occluded-windows"
      },
      {
        "label": "edgelight",
        "url": "edgelight.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "alwaysOnTop": true,
        "width": 1920,
        "height": 1080,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=CalculateNativeWinOcclusion --disable-renderer-backgrounding --disable-background-timer-throttling --disable-backgrounding-occluded-windows"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Functionality-only modular desktop overlay.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
