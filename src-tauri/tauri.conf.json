{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aura",
  "version": "0.5.0-pre",
  "identifier": "com.freebuff.aura",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    },
    "windows": [
      {
        "label": "settings",
        "title": "Aura Settings",
        "url": "index.html",
        "width": 1000,
        "height": 680,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "visible": true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=CalculateNativeWinOcclusion --disable-renderer-backgrounding --disable-background-timer-throttling --disable-backgrounding-occluded-windows"
      },
      {
        "label": "wallpaper",
        "url": "wallpaper.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "alwaysOnTop": false,
        "width": 1920,
        "height": 1080,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=CalculateNativeWinOcclusion --disable-renderer-backgrounding --disable-background-timer-throttling --disable-backgrounding-occluded-windows"
      },
      {
        "label": "notch",
        "url": "notch.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "alwaysOnTop": true,
        "width": 240,
        "height": 44,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=CalculateNativeWinOcclusion --disable-renderer-backgrounding --disable-background-timer-throttling --disable-backgrounding-occluded-windows"
      },
      {
        "label": "clock",
        "url": "clock.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "alwaysOnTop": true,
        "width": 468,
        "height": 338,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=CalculateNativeWinOcclusion --disable-renderer-backgrounding --disable-background-timer-throttling --disable-backgrounding-occluded-windows"
      },
      {
        "label": "todo",
        "url": "todo.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "alwaysOnTop": true,
        "width": 508,
        "height": 648,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=CalculateNativeWinOcclusion --disable-renderer-backgrounding --disable-background-timer-throttling --disable-backgrounding-occluded-windows"
      },
      {
        "label": "start",
        "url": "start.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "alwaysOnTop": true,
        "width": 688,
        "height": 588,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=CalculateNativeWinOcclusion --disable-renderer-backgrounding --disable-background-timer-throttling --disable-backgrounding-occluded-windows"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Lightweight modular desktop overlay: wallpaper engine, clock, to-do and a smart notch.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
