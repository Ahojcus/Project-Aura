{
  "identifier": "default",
  "description": "Permissions for all Aura windows.",
  "windows": ["settings", "notch", "wallpaper", "clock", "todo"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "dialog:default"
  ]
}
